---
import { site } from "../../data/site";
import { navigation } from "../../data/navigation";
import NavLink from "../ui/NavLink.astro";
---

<footer class="border-t border-border bg-surface">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <a href="/" class="font-heading text-xl font-semibold text-text">
          {site.name}
        </a>

        <p class="mt-4 text-sm text-text-muted">{site.description}</p>
      </div>

      <nav aria-label="Footer navigation">
        <ul class="flex flex-col gap-3">
          {
            navigation.map((link) => (
              <li>
                <NavLink {...link} />
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-4 border-t border-border pt-6 text-sm text-text-muted md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {site.copyright}. All rights reserved.</p>

      <div class="flex gap-6">
        <a href="/privacy" class="hover:text-text transition-colors"> Privacy </a>

        <a href="/terms" class="hover:text-text transition-colors"> Terms </a>
      </div>
    </div>
  </div>
</footer>
