---
interface Project {
  title: string;
  description: string;
  category: string;
  image?: ImageMetadata;
  href?: string;
}

interface Props {
  items: Project;
}

const { items } = Astro.props;
---

<article class="group">
  <!-- Project preview -->
  <a href={items.href} class="block overflow-hidden rounded-md border border-border bg-white">
    {
      items.image ? (
        <div class="aspect-16/10 overflow-hidden">
          <img
            src={items.image.src}
            alt={`${items.title} project preview`}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          />
        </div>
      ) : (
        <div class="flex aspect-16/10 items-center justify-center bg-zinc-200">
          <span class="text-sm text-text-muted">Project preview</span>
        </div>
      )
    }
  </a>

  <!-- Project information -->
  <div class="mt-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">
      {items.category}
    </p>

    <h3 class="mt-2 font-heading text-2xl font-semibold tracking-tight">
      {items.title}
    </h3>

    <p class="mt-3 max-w-md text-sm leading-6 text-text-muted">
      {items.description}
    </p>

    <a
      href={items.href}
      class="group/link mt-5 inline-flex items-center gap-2 text-sm font-semibold text-text transition-colors hover:text-accent">
      View project
      <span class="transition-transform group-hover/link:translate-x-1"> → </span>
    </a>
  </div>
</article>
